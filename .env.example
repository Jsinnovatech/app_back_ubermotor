# ============================================================
# UberMotor Backend — Variables de entorno (Railway)
# Copia este archivo a .env para desarrollo local.
# En Railway: Settings -> Variables -> pega cada una.
# ============================================================

# --- OBLIGATORIAS (sin esto no arranca) ---
DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_HOST.proxy.rlwy.net:TU_PUERTO/railway
SECRET_KEY=cambiar-en-produccion-ubermotor

# --- OPCIONALES (agregar cuando se habiliten) ---

# Resend (recuperacion de password / verificacion de email)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=sistemas@jsinnovatech.com
EMAIL_FROM_NAME=UberMotor

# ImageKit (fotos de la moto / DNI / licencia del conductor)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Mercado Pago (recargas del conductor por MP - webhook)
MERCADOPAGO_ACCESS_TOKEN=
